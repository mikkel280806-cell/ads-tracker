# =============================================================================
# Adtrack — Environment Variables (100% Serverless Trendtrack-Style Tools)
# Copy to .env.local for local dev, or add in Vercel Project Settings
# =============================================================================

# 1. SUPABASE (Postgres Database + Permanent Media Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. META AD LIBRARY SCRAPING (ScrapeCreators API)
SCRAPECREATORS_API_KEY=

# 3. VIDEO AD TRANSCRIPTION (Speech-to-Text — pick one, both have generous free tiers!)
# GROQ_API_KEY     -> console.groq.com (FREE tier, Whisper large-v3-turbo, ~1-2s, DK + EN)
# DEEPGRAM_API_KEY -> console.deepgram.com ($200 free starter credit, Nova-2)
GROQ_API_KEY=
DEEPGRAM_API_KEY=

# 4. CLOUDFLARE 403 FALLBACK (Firecrawl API — 1,000 free credits/month, no card!)
# Only called automatically when a shop or landing page blocks direct fetch (403/503)
FIRECRAWL_API_KEY=

# 5. OPTIONAL SHOP TRAFFIC & SECURITY
SIMILARWEB_API_KEY=
RAPIDAPI_KEY=
CRON_SECRET=
APP_PASSWORD=
