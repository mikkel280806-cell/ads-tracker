# =============================================================================
# Adtrack — Environment Variables
# Copy this file to .env.local for local dev, or add to Vercel Project Settings
# =============================================================================

# 1. SUPABASE (Database + Permanent Video/Image Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. SCRAPING CONNECTOR (Meta Ad Library & Instagram Link Import)
SCRAPECREATORS_API_KEY=
APIFY_API_TOKEN=

# 3. SIMILARWEB / SHOP TRAFFIC CONNECTOR (Monthly Visits + Traffic Over Time)
# Use official SimilarWeb API OR an affordable RapidAPI SimilarWeb key
SIMILARWEB_API_KEY=
RAPIDAPI_KEY=

# 4. INSTABOX.SH ON-DEMAND AI & VIDEO WORKER (Auto-wake after 30 min idle)
INSTABOX_API_KEY=
INSTABOX_MACHINE_ID=
INSTABOX_WORKER_CMD=/data/advault-worker/analyze-ad.sh

# 5. OPTIONAL CLOUD AI FALLBACK & PASSCODE LOCK
GROQ_API_KEY=
GEMINI_API_KEY=
APP_PASSWORD=
