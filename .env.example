# =============================================================================
# Adtrack — Environment Variables (100% Serverless API Stack)
# Copy to .env.local for local dev, or add in Vercel Project Settings
# =============================================================================

# 1. SUPABASE (Postgres Database + Permanent Media Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. META AD LIBRARY SCRAPING (ScrapeCreators API)
SCRAPECREATORS_API_KEY=

# 3. SHOP TRAFFIC & ANALYTICS (Optional — falls back to free Tranco rank)
SIMILARWEB_API_KEY=
RAPIDAPI_KEY=

# 4. AI AD ANALYSIS & VIDEO TRANSCRIPTION (100% Serverless REST APIs)
# GEMINI_API_KEY -> Google AI Studio (free tier available, multimodal vision + copy)
# OPENAI_API_KEY -> Optional alternative (gpt-4o-mini vision)
# GROQ_API_KEY   -> Video transcription via Whisper large-v3-turbo + LLM fallback
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# 5. OPTIONAL AUTOMATION & SECURITY
CRON_SECRET=
APP_PASSWORD=
