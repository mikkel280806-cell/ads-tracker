# 2. META AD LIBRARY SCRAPING (ScrapeCreators API)
SCRAPECREATORS_API_KEY=

# 3. OPTIONAL SHOP TRAFFIC & AUTOMATION
SIMILARWEB_API_KEY=
RAPIDAPI_KEY=
CRON_SECRET=
APP_PASSWORD=
