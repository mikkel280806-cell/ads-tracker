# =============================================================================
# AdVault — Environment Variables
# Copy this file to .env.local for local dev, or add to Vercel Project Settings
# =============================================================================

# 1. SUPABASE (Database + Permanent Video/Image Storage)
# Leave blank to run in Demo Mode with built-in sample ads & localStorage persistence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. OPTIONAL SIMPLE PASSCODE LOCK (Recommended when deployed publicly on Vercel)
# Leave blank for completely open personal access
APP_PASSWORD=

# 3. SCRAPING CONNECTOR (Meta Ad Library & Instagram Link Import)
# Recommended: ScrapeCreators (https://scrapecreators.com) or Apify (https://apify.com)
SCRAPECREATORS_API_KEY=
APIFY_API_TOKEN=

# 4. INSTABOX.SH ON-DEMAND AI & VIDEO WORKER (Auto-wake after 30 min idle)
# Your InstaBox wakes in < 1s via POST /v1/machines/{id}/wake + exec
INSTABOX_API_KEY=
INSTABOX_MACHINE_ID=
INSTABOX_WORKER_CMD=/data/advault-worker/analyze-ad.sh

# 5. OPTIONAL CLOUD AI FALLBACK (If you want cloud AI without InstaBox)
GROQ_API_KEY=
GEMINI_API_KEY=
